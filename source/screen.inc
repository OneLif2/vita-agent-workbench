static void draw_at(uint32_t*p,int x,int y,int scale,const char*s,uint32_t color) {
 for(;*s;s++,x+=6*scale) {
  const char *c=strchr(dict,*s);
  if(!c||x+5*scale>=W)continue;
  const uint8_t*g=font[c-dict];
  for(int r=0;r<7*scale;r++)for(int t=0;t<5*scale;t++)if(g[r/scale]&(1u<<(4-t/scale)))p[(y+r)*PITCH+x+t]=color;
 }
}

static void draw(uint32_t*p,int y,int scale,const char*s,uint32_t color) {
 draw_at(p,36,y,scale,s,color);
